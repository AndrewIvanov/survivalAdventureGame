    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-sqlite.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
