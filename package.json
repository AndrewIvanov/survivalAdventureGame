{
  "name": "village-survival",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js --dev",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
