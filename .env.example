# Local launches use SQLite when DATABASE_URL is absent.
# To use Neon, uncomment and insert the connection string from Connect.
# Keep sslmode=require and channel_binding=require from Neon's connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Optional direct URL for migration (Connection pooling disabled in Neon Connect).
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require&channel_binding=require
# PORT=3000
# HOST=0.0.0.0
# DB_PATH=data/village.sqlite
